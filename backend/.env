# AURIANCE Configuration

# ==================== DATABASE ====================
# Pour SQLite (developpement local):
DATABASE_URL=sqlite:///./auriance.db
# Pour PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/auriance_medical

# ==================== REDIS (Cache) ====================
REDIS_URL=redis://localhost:6379/0

# ==================== AUTHENTICATION ====================
SECRET_KEY=auriance-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8090
DEBUG=True

# ==================== WHISPER ====================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:3000

# ==================== LOGGING ====================
LOG_LEVEL=INFO

# ==================== GEMINI AI ====================
GEMINI_API_KEY=AIzaSyDwcZmrYT2LHCjtohI28Iips5quxzjh8LM
